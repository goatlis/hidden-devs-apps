    originalSkyProps.StarCount = originalSky.StarCount
    originalSkyProps.SkyboxBk = originalSky.SkyboxBk
    originalSkyProps.SkyboxDn = originalSky.SkyboxDn
    originalSkyProps.SkyboxFt = originalSky.SkyboxFt
    originalSkyProps.SkyboxLf = originalSky.SkyboxLf
    originalSkyProps.SkyboxRt = originalSky.SkyboxRt
    originalSkyProps.SkyboxUp = originalSky.SkyboxUp
end

